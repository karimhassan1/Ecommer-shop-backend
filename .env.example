APP_NAME="Rosera Bloom"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# The SPA origin. Used to build email links and to allow CORS.
FRONTEND_URL=http://localhost:9100

# Where contact form notifications are delivered.
ADMIN_EMAIL=admin@roserabloom.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@roserabloom.test"
MAIL_FROM_NAME="${APP_NAME}"

# Branding used by the transactional email templates.
MAIL_BRAND_NAME="${APP_NAME}"
MAIL_SUPPORT_EMAIL="support@roserabloom.test"
MAIL_SUPPORT_PHONE="+1 (555) 010-2030"

# ---------------------------------------------------------------------------
# Email verification
# ---------------------------------------------------------------------------
# Sign-up emails a 6 digit code (plus a signed link). The SPA keeps an
# unverified account on the verification screen until the code is entered.
# The SMTP credentials above are all that is needed; nothing extra here.
# Use MAIL_MAILER=log while developing to read the code from storage/logs.

# Personal access tokens are used by the SPA (Authorization: Bearer ...).
AUTH_GUARD=sanctum

# ---------------------------------------------------------------------------
# Media / image storage
# ---------------------------------------------------------------------------
# Local disk (default). Run `php artisan storage:link` once.
MEDIA_DISK=public
# Optional absolute base URL. Leave empty to use APP_URL/storage.
MEDIA_URL=
MEDIA_FOLDER=products
MEDIA_MAX_KB=5120
# Whether uploads are written with `ACL: public-read`. Leave false for Oracle
# Cloud (it ignores canned ACLs and uses a bucket policy instead); set true for
# a plain AWS S3 / MinIO bucket.
MEDIA_PUBLIC_ACL=false

# ---------------------------------------------------------------------------
# Oracle Cloud Object Storage (the production target)
# ---------------------------------------------------------------------------
# The bucket is reached through Oracle's S3-compatible endpoint, but browsers
# download from the native object storage URL. Nothing in the code changes when
# switching between the local disk and Oracle: it is all driven by these values.
#
#   MEDIA_DISK=s3
#   AWS_ACCESS_KEY_ID=<customer secret key id>
#   AWS_SECRET_ACCESS_KEY=<customer secret>
#   AWS_DEFAULT_REGION=<e.g. us-sanjose-1>
#   AWS_BUCKET=<bucket name>
#   AWS_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
#   AWS_USE_PATH_STYLE_ENDPOINT=true
#   OCI_NAMESPACE=<object storage namespace>
#   OCI_REGION=<e.g. us-sanjose-1>
#   OCI_PUBLIC_URL=https://objectstorage.<region>.oraclecloud.com/n/<namespace>/b/<bucket>/o
#
# A plain AWS S3 / DigitalOcean Spaces / MinIO bucket works too with the same
# AWS_* block plus MEDIA_PUBLIC_ACL=true.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

OCI_NAMESPACE=
OCI_REGION=
OCI_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Pakistan provinces and cities (third party geo data)
# ---------------------------------------------------------------------------
# The checkout and the profile form offer every Pakistani province with its
# cities. The list is pulled from a public country/state/city provider and
# merged over `config/pakistan.php`, which stays as the offline fallback — a
# provider outage degrades to the shipped list instead of emptying the selects.
#
# The default provider needs no key. Set GEO_ENABLED=false to skip the network
# call entirely (tests do this), and point GEO_BASE_URL at a different provider
# or your own proxy if the default one changes shape.
GEO_ENABLED=true
GEO_BASE_URL=https://countriesnow.space/api/v0.1
GEO_COUNTRY=Pakistan
GEO_TIMEOUT=8
GEO_CACHE_TTL=86400

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# GraphQL schema cache
# ---------------------------------------------------------------------------
# The schema is generated from PHP attributes (models + @rules strings). When it
# is cached, a change to a model or a validation rule is NOT picked up until the
# cache is cleared. Disabled here so local edits always apply immediately.
# In production set LIGHTHOUSE_SCHEMA_CACHE_ENABLE=true and run
# `php artisan lighthouse:clear-cache` on every deploy.
LIGHTHOUSE_SCHEMA_CACHE_ENABLE=false
LARAQL_CACHE=false
