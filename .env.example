APP_NAME="Rosera Bloom"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# The SPA origin. Used to build email links and to allow CORS.
FRONTEND_URL=http://localhost:9100

# Where contact form notifications are delivered.
ADMIN_EMAIL=admin@roserabloom.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@roserabloom.test"
MAIL_FROM_NAME="${APP_NAME}"

# Branding used by the transactional email templates.
MAIL_BRAND_NAME="${APP_NAME}"
MAIL_SUPPORT_EMAIL="support@roserabloom.test"
MAIL_SUPPORT_PHONE="+1 (555) 010-2030"

# ---------------------------------------------------------------------------
# Email verification
# ---------------------------------------------------------------------------
# Sign-up emails a 6 digit code (plus a signed link). The SPA keeps an
# unverified account on the verification screen until the code is entered.
# The SMTP credentials above are all that is needed; nothing extra here.
# Use MAIL_MAILER=log while developing to read the code from storage/logs.

# Personal access tokens are used by the SPA (Authorization: Bearer ...).
AUTH_GUARD=sanctum

# ---------------------------------------------------------------------------
# Media / image storage
# ---------------------------------------------------------------------------
# Local disk (default). Run `php artisan storage:link` once.
MEDIA_DISK=public
# Optional absolute base URL. Leave empty to use APP_URL/storage.
MEDIA_URL=
MEDIA_FOLDER=products
MEDIA_MAX_KB=5120

# To move images to S3 (or DigitalOcean Spaces / MinIO), set:
#   MEDIA_DISK=s3
#   MEDIA_URL=https://<bucket>.s3.<region>.amazonaws.com   (or leave empty to
#                                                          use AWS_URL)
# and fill in the AWS_* block below. Nothing in the code needs to change.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# GraphQL schema cache
# ---------------------------------------------------------------------------
# The schema is generated from PHP attributes (models + @rules strings). When it
# is cached, a change to a model or a validation rule is NOT picked up until the
# cache is cleared. Disabled here so local edits always apply immediately.
# In production set LIGHTHOUSE_SCHEMA_CACHE_ENABLE=true and run
# `php artisan lighthouse:clear-cache` on every deploy.
LIGHTHOUSE_SCHEMA_CACHE_ENABLE=false
LARAQL_CACHE=false
